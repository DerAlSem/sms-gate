[Unit]
Description=Is the tunnel carrying anything
# The tunnel's unit name is deliberately absent. It belongs to the machine, and naming it
# here would be worse than untidy: `Wants=` on a published placeholder makes systemd try to
# *start* a wg-quick instance that has no configuration. Ordering therefore lives in a
# machine-local drop-in, which is what drop-ins are for — `EnvironmentFile` parameterises the
# script but cannot reach `After=`/`Wants=`, and that gap is how this file came to be edited
# in place on the host and then silently diverge from the one here.
#
#   /etc/systemd/system/wg-tunnel-check.service.d/local.conf
#   [Unit]
#   After=wg-quick@<iface>.service
#   Wants=wg-quick@<iface>.service

[Service]
Type=oneshot
# The peer address and the unit name live on the machine, not here: this file is published,
# and a default pointing nowhere would make the watchdog restart a healthy tunnel every two
# minutes — the monitor becoming the outage. The script refuses to run until they are set.
EnvironmentFile=/etc/wg-tunnel-check.env
ExecStart=/usr/local/sbin/wg-tunnel-check
# It restarts the tunnel itself and alerts on its own judgement, because the difference
# between one silent check and a fault a restart cannot fix is not something OnFailure= can
# tell. A non-zero exit is the honest report of a silent tunnel, not a reason to shout.
