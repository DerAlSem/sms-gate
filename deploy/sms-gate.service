[Unit]
Description=SMS Gate API
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=sms-gate-notify@%n.service

[Service]
Type=simple
User=smsgate
Group=dialout
WorkingDirectory=/opt/sms-gate
# Loopback, not every interface. nginx is the only thing that should reach this, and it
# reaches it over the loopback — binding wider made the application answerable from the home
# network directly, and once a tunnel gave the host another address, from the far end of that
# too. Nothing needed it.
#
# `--proxy-headers` with the loopback trusted is what puts the caller's own address into the
# access log instead of nginx's. Nothing recorded where requests came from before, which was
# survivable while reaching the gateway meant being on this network; with one public entrance
# and long-lived tokens behind it, a token used from somewhere it has never been used from
# would otherwise be indistinguishable from an ordinary call. The header is trusted only from
# the loopback, which after the bind above is the only place it can arrive from.
ExecStart=/opt/sms-gate/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 30080 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
# Paired with the 60s the gateway spends waiting for its modem to reappear (see
# _DEVICE_WAIT). A failed start therefore costs 90s, so five of them span 450s and cannot
# exhaust StartLimitBurst inside its 300s window — which matters because a restart
# provoked by a lost link lands while the modem is still re-enumerating. A fast crash (a
# bad .env, an import error) still trips the limit within seconds, which is what it is for.
RestartSec=30
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/sms-gate/.env

[Install]
WantedBy=multi-user.target
