#: app/admin/settings_layout.py:50
msgid "Modem and sending"
msgstr "Модем и отправка"

#: app/admin/settings_layout.py:51
msgid "Max parts per multipart SMS"
msgstr "Максимум частей у одной SMS"

#: app/admin/settings_layout.py:52
msgid ""
"How many parts one SMS may be split into. Longer text is refused before "
"sending, rather than sent cut short."
msgstr ""
"На сколько частей может разбиваться одна SMS. Более длинный текст будет "
"отклонён при отправке, а не обрезан."

#: app/admin/settings_layout.py:54
msgid "Retry delays for a failed send"
msgstr "Задержки перед повтором при сбое отправки"

#: app/admin/settings_layout.py:55
msgid ""
"Comma-separated seconds to wait before each retry after a transient send "
"failure. The number of delays sets the number of retries. Empty means one"
" attempt only, no retry."
msgstr ""
"Секунды через запятую — сколько ждать перед каждой повторной попыткой "
"после временного сбоя отправки. Количество задержек задаёт количество "
"повторов. Пусто — только одна попытка, без повтора."

#: app/admin/settings_layout.py:58
msgid "Auto-recover the modem"
msgstr "Автовосстановление модема"

#: app/admin/settings_layout.py:59
msgid "Automatically recover the modem when it loses network registration."
msgstr "Автоматически восстанавливать модем при потере регистрации в сети."

#: app/admin/settings_layout.py:60
msgid "Recover on repeated send failures too"
msgstr "Восстанавливать и при повторных сбоях отправки"

#: app/admin/settings_layout.py:61
msgid ""
"Also treat repeated send failures as a reason to recover the modem. Off "
"means only lost registration triggers recovery."
msgstr ""
"Считать повторные сбои отправки поводом для восстановления модема. Выкл —"
" восстановление только при потере регистрации."

#: app/admin/settings_layout.py:63
msgid "Default country for phone numbers"
msgstr "Страна по умолчанию для телефонных номеров"

#: app/admin/settings_layout.py:64
msgid "ISO country code used to validate phone numbers, e.g. RU, US, GB."
msgstr "Код страны ISO для проверки телефонных номеров, например RU, US, GB."

#: app/admin/settings_layout.py:65
msgid "Give up waiting for delivery after"
msgstr "Перестать ждать доставку после"

#: app/admin/settings_layout.py:66
msgid "Seconds after which a message stuck as \"sent\" is marked \"expired\"."
msgstr ""
"Через сколько секунд сообщение, застрявшее в статусе «отправлено», "
"помечается «просрочено»."

#: app/admin/settings_layout.py:67
msgid "Block a number after this many failures"
msgstr "Блокировать номер после стольких сбоев"

#: app/admin/settings_layout.py:68
msgid "How many permanent failures in a row before a number is blocked."
msgstr "Сколько подряд окончательных сбоев до блокировки номера."

#: app/admin/settings_layout.py:70
msgid "Telegram alerts"
msgstr "Уведомления в Телеграм"

#: app/admin/settings_layout.py:71
msgid "Telegram bot token"
msgstr "Токен Telegram-бота"

#: app/admin/settings_layout.py:72
msgid ""
"The alerting bot's own API token. Blank disables Telegram alerting "
"entirely."
msgstr ""
"Собственный API-токен бота для уведомлений. Пусто — уведомления в "
"Телеграм полностью выключены."

#: app/admin/settings_layout.py:74
msgid "Where alerts go — the Telegram chat"
msgstr "Куда приходят алерты — чат Телеграма"

#: app/admin/settings_layout.py:75
msgid "The chat id alerts are sent to."
msgstr "Id чата, куда отправляются алерты."

#: app/admin/settings_layout.py:76
msgid "Name shown in notifications"
msgstr "Имя, показываемое в уведомлениях"

#: app/admin/settings_layout.py:77
msgid ""
"Label shown in every notification, so alerts from several gateways can be"
" told apart. Blank uses the server's hostname."
msgstr ""
"Метка в каждом уведомлении — чтобы отличать алерты разных шлюзов. Пусто —"
" имя хоста сервера."

#: app/admin/settings_layout.py:79
msgid "Notify on system errors"
msgstr "Уведомлять о системных ошибках"

#: app/admin/settings_layout.py:80
msgid "Send crashes and exceptions (error-level log records) to Telegram."
msgstr "Отправлять в Телеграм сбои и исключения (записи журнала уровня error)."

#: app/admin/settings_layout.py:81
msgid "Notify when a send fails"
msgstr "Уведомлять о сбое отправки"

#: app/admin/settings_layout.py:82
msgid "Notify when an outbound SMS fails to send."
msgstr "Уведомлять, когда исходящая SMS не отправилась."

#: app/admin/settings_layout.py:83
msgid "Notify on delivery failure"
msgstr "Уведомлять о сбое доставки"

#: app/admin/settings_layout.py:84
msgid "Notify on a delivery failure, or when a number is blacklisted."
msgstr "Уведомлять о сбое доставки или о попадании номера в чёрный список."

#: app/admin/settings_layout.py:85
msgid "Notify on an unmatched delivery report"
msgstr "Уведомлять о несопоставленном отчёте о доставке"

#: app/admin/settings_layout.py:86
msgid ""
"Notify when a delivery report could not be matched to any message. The "
"report itself is recorded either way."
msgstr ""
"Уведомлять, если отчёт о доставке не удалось сопоставить ни с одним "
"сообщением. Сам отчёт при этом всё равно записывается."

#: app/admin/settings_layout.py:88
msgid "Notify on every inbound SMS"
msgstr "Уведомлять о каждой входящей SMS"

#: app/admin/settings_layout.py:89
msgid "Notify on every inbound SMS received. Can be noisy on a busy gateway."
msgstr ""
"Уведомлять о каждой полученной входящей SMS. На загруженном шлюзе может "
"быть много уведомлений."

#: app/admin/settings_layout.py:90
msgid "Notify when an inbound webhook fails"
msgstr "Уведомлять о сбое входящего вебхука"

#: app/admin/settings_layout.py:91
msgid ""
"Notify when delivering an inbound SMS to the application's webhook fails "
"— otherwise the drop is silent."
msgstr ""
"Уведомлять, когда доставка входящей SMS на вебхук приложения не удалась —"
" иначе потеря останется незамеченной."

#: app/admin/settings_layout.py:93
msgid "Notify when a route is refused"
msgstr "Уведомлять об отказе маршрута"

#: app/admin/settings_layout.py:94
msgid "Notify when a route is refused, unreadable, or cannot be attempted at all."
msgstr ""
"Уведомлять, когда маршрут отказал, не читается или его вообще нельзя "
"попробовать."

#: app/admin/settings_layout.py:96
msgid "Allow replying to alerts to send an SMS"
msgstr "Разрешить отвечать на алерты для отправки SMS"

#: app/admin/settings_layout.py:97
msgid ""
"Reply to a notification in Telegram to send an SMS back. Takes effect "
"after a restart."
msgstr ""
"Ответ на уведомление в Телеграме отправляет SMS в ответ. Действует после "
"перезапуска."

#: app/admin/settings_layout.py:100
msgid "Number verification"
msgstr "Проверка номера"

#: app/admin/settings_layout.py:101
msgid "Order of verification rungs"
msgstr "Порядок ступеней проверки"

#: app/admin/settings_layout.py:102
msgid ""
"Comma-separated list of rungs offered, cheapest first. A rung nothing can"
" prove is never offered, whatever its place here."
msgstr ""
"Ступени через запятую, от дешёвой к дорогой. Ступень, которую нечем "
"подтвердить, не предлагается — независимо от места в списке."

#: app/admin/settings_layout.py:104
msgid "The gateway's own phone number"
msgstr "Собственный номер шлюза"

#: app/admin/settings_layout.py:105
msgid ""
"The number a subscriber must call or text. Blank means the rungs that "
"need it are never offered."
msgstr ""
"Номер, на который абонент должен позвонить или написать. Пусто — ступени,"
" которым он нужен, не предлагаются."

#: app/admin/settings_layout.py:107
msgid "How long a verification stays open"
msgstr "Сколько верификация остаётся открытой"

#: app/admin/settings_layout.py:108
msgid "Seconds before an open verification expires."
msgstr "Через сколько секунд открытая верификация истекает."

#: app/admin/settings_layout.py:109
msgid "How long the call-in rung stays open"
msgstr "Сколько открыта ступень обратного звонка"

#: app/admin/settings_layout.py:110
msgid ""
"Seconds a call_in verification stays open; capped by how long the "
"verification itself stays open, above."
msgstr ""
"Сколько секунд открыта верификация через call_in; не может быть дольше, "
"чем время выше."

#: app/admin/settings_layout.py:112
msgid "Wrong codes allowed"
msgstr "Допустимо неверных кодов"

#: app/admin/settings_layout.py:113
msgid ""
"How many wrong codes are tolerated before a verification stops accepting "
"any."
msgstr ""
"Сколько неверных кодов допускается, прежде чем верификация перестанет "
"принимать любые."

#: app/admin/settings_layout.py:115
msgid "SMS wording for verification codes"
msgstr "Текст SMS с кодом подтверждения"

#: app/admin/settings_layout.py:116
msgid ""
"Set on each application's own page (Apps), not here — an application with"
" no template there never gets a code by SMS."
msgstr ""
"Настраивается на странице самого приложения (Приложения), а не здесь — "
"без записи там приложению код по SMS не отправляется."

#: app/admin/settings_layout.py:119
msgid "Routes by operator"
msgstr "Маршруты по операторам"

#: app/admin/settings_layout.py:120
msgid "Which way out each operator takes"
msgstr "Каким путём уходит трафик каждого оператора"

#: app/admin/settings_layout.py:121
msgid ""
"JSON list naming the routes tried for each operator, in order. \"*\" "
"answers for an operator with no entry, \"?\" for one that could not be "
"resolved."
msgstr ""
"JSON-список маршрутов для каждого оператора, по порядку. «*» — для "
"оператора без записи, «?» — для того, который не удалось определить."

#: app/admin/settings_layout.py:124
msgid "Flag a routing rule after this many days"
msgstr "Отмечать правило маршрутизации после стольких дней"

#: app/admin/settings_layout.py:125
msgid ""
"Report a routing-rule entry that has stood this many days without being "
"revisited — a rule set during an outage can outlive it."
msgstr ""
"Сообщать о записи правила маршрутизации, которая стоит без пересмотра "
"столько дней — правило, заданное на время сбоя, может его пережить."

#: app/admin/settings_layout.py:127
msgid "Look up the operator for a number"
msgstr "Определять оператора номера"

#: app/admin/settings_layout.py:128
msgid "Enable looking up a number's operator and region."
msgstr "Включить определение оператора и региона номера."

#: app/admin/settings_layout.py:130
msgid "Vendors"
msgstr "Поставщики"

#: app/admin/settings_layout.py:131
msgid "Telegram Gateway API token"
msgstr "API-токен Telegram Gateway"

#: app/admin/settings_layout.py:132
msgid ""
"Access token for the Telegram Gateway verification rung. Blank means that"
" rung is never offered."
msgstr ""
"Токен доступа для ступени проверки через Telegram Gateway. Пусто — эта "
"ступень не предлагается."

#: app/admin/settings_layout.py:134
msgid "Telegram Gateway sender channel"
msgstr "Канал-отправитель Telegram Gateway"

#: app/admin/settings_layout.py:135
msgid ""
"Username of the verified Telegram channel codes are sent from. Blank uses"
" the vendor's own sender."
msgstr ""
"Имя пользователя верифицированного канала Телеграма, от которого "
"отправляются коды. Пусто — отправитель по умолчанию у вендора."

#: app/admin/settings_layout.py:137
msgid "This gateway's public address for delivery reports"
msgstr "Публичный адрес этого шлюза для отчётов о доставке"

#: app/admin/settings_layout.py:139
msgid ""
"This gateway's own public HTTPS address, so the Telegram Gateway can "
"report deliveries back to it, e.g. https://sms.example.org. Blank means "
"no delivery reports and no refunds are ever recorded."
msgstr ""
"Собственный публичный HTTPS-адрес этого шлюза, чтобы Telegram Gateway мог"
" сообщать сюда о доставке, например https://sms.example.org. Пусто — "
"отчётов о доставке и возвратов не будет вовсе."

#: app/admin/settings_layout.py:142
msgid "uCaller secret key"
msgstr "Секретный ключ uCaller"

#: app/admin/settings_layout.py:143
msgid ""
"The secret key half of the uCaller credential, from the cabinet under "
"\"Мои сервисы\". Blank means the flash_call rung is never offered."
msgstr ""
"Половина учётных данных uCaller — секретный ключ, из личного кабинета, "
"раздел «Мои сервисы». Пусто — ступень flash_call не предлагается."

#: app/admin/settings_layout.py:145
msgid "uCaller service id"
msgstr "Id сервиса uCaller"

#: app/admin/settings_layout.py:146
msgid ""
"The service id half of the uCaller credential, the second half of the "
"pair above."
msgstr "Вторая половина учётных данных uCaller — id сервиса, пара к ключу выше."

#: app/admin/settings_layout.py:148
msgid "Messenger accounts and brands"
msgstr "Аккаунты мессенджеров и бренды"

#: app/admin/settings_layout.py:149
msgid ""
"JSON: the account each brand owns on each messenger. Which application "
"may send under which brand is set on that application's own page (Apps), "
"not here."
msgstr ""
"JSON: какой аккаунт закреплён за каждым брендом на каждом мессенджере. "
"Какому приложению доступен какой бренд — настраивается на странице самого"
" приложения (Приложения), а не здесь."

#: app/admin/settings_layout.py:152
msgid "Messenger sending limits"
msgstr "Лимиты отправки в мессенджерах"

#: app/admin/settings_layout.py:153
msgid ""
"JSON: hourly and daily sending maxima per account, and the minimum time "
"between two messages to the same recipient."
msgstr ""
"JSON: максимумы отправки в час и в сутки на аккаунт, а также минимальный "
"интервал между двумя сообщениями одному получателю."

#: app/admin/settings_layout.py:156
msgid "Money limits and protection"
msgstr "Лимиты и защита денег"

#: app/admin/settings_layout.py:157
msgid "Paid verifications allowed per hour"
msgstr "Лимит платных проверок в час"

#: app/admin/settings_layout.py:158
msgid ""
"How many paid rungs (call or Telegram) this gateway may attempt per "
"rolling hour, across every number and application together."
msgstr ""
"Сколько платных ступеней (звонок или Телеграм) шлюз может попробовать за "
"скользящий час — суммарно по всем номерам и приложениям."

#: app/admin/settings_layout.py:160
msgid "Paid verifications allowed per day"
msgstr "Лимит платных проверок в сутки"

#: app/admin/settings_layout.py:161
msgid ""
"How many paid rungs this gateway may attempt per rolling day, across "
"every number and application together."
msgstr ""
"Сколько платных ступеней шлюз может попробовать за скользящие сутки — "
"суммарно по всем номерам и приложениям."

#: app/admin/settings_layout.py:163
msgid "Alert below this Telegram Gateway balance"
msgstr "Алерт при балансе Telegram Gateway ниже"

#: app/admin/settings_layout.py:164
msgid ""
"Alert when the last-seen Telegram Gateway balance falls below this, in "
"the vendor's own units."
msgstr ""
"Алерт, когда последний известный баланс Telegram Gateway опускается ниже "
"этого значения, в собственных единицах вендора."

#: app/admin/settings_layout.py:166
msgid "Alert below this uCaller balance"
msgstr "Алерт при балансе uCaller ниже"

#: app/admin/settings_layout.py:167
msgid ""
"Alert when the uCaller balance falls below this. 0 means not configured —"
" there is no account to watch yet."
msgstr ""
"Алерт, когда баланс uCaller опускается ниже этого значения. 0 — не "
"настроено, аккаунта для отслеживания пока нет."

#: app/admin/settings_layout.py:169
msgid "Minimum time between two paid attempts"
msgstr "Минимальный интервал между двумя платными попытками"

#: app/admin/settings_layout.py:170
msgid ""
"Seconds that must pass between two paid verification attempts on the same"
" number."
msgstr ""
"Сколько секунд должно пройти между двумя платными попытками проверки "
"одного номера."

#: app/admin/settings_layout.py:172
msgid "Paid attempts per number per minute"
msgstr "Платных попыток на номер в минуту"

#: app/admin/settings_layout.py:173
msgid "How many paid attempts one number may have within a rolling minute."
msgstr "Сколько платных попыток допустимо для одного номера за скользящую минуту."

#: app/admin/settings_layout.py:174
msgid "Paid attempts per number per day"
msgstr "Платных попыток на номер в сутки"

#: app/admin/settings_layout.py:175
msgid "How many paid attempts one number may have within a rolling day."
msgstr "Сколько платных попыток допустимо для одного номера за скользящие сутки."

#: app/admin/settings_layout.py:177
msgid "Webhooks"
msgstr "Вебхуки"

#: app/admin/settings_layout.py:178
msgid "Inbound SMS webhooks"
msgstr "Вебхуки входящих SMS"

#: app/admin/settings_layout.py:179
#, python-brace-format
msgid ""
"JSON list of routes that receive inbound SMS by prefix, e.g. "
"[{\"prefix\":\"X\",\"webhook_url\":\"https://...\",\"bearer\":\"...\"}]."
msgstr ""
"JSON-список маршрутов, получающих входящие SMS по префиксу, напр. "
"[{\"prefix\":\"X\",\"webhook_url\":\"https://...\",\"bearer\":\"...\"}]."

#: app/admin/settings_layout.py:181
msgid "Delivery status webhooks"
msgstr "Вебхуки статусов доставки"

#: app/admin/settings_layout.py:182
msgid "Set on each application's own page (Apps), not here."
msgstr "Настраивается на странице самого приложения (Приложения), а не здесь."

#: app/admin/settings_layout.py:184
msgid "Advanced"
msgstr "Дополнительно"

#: app/admin/settings_layout.py:185
msgid "Suppress repeated identical alerts for"
msgstr "Не повторять одинаковый алерт в течение"

#: app/admin/settings_layout.py:186
msgid "Seconds during which an identical alert is not sent again."
msgstr "Сколько секунд одинаковый алерт не отправляется повторно."

#: app/admin/settings_layout.py:187
msgid "Backup relay for alerts"
msgstr "Резервный релей для алертов"

#: app/admin/settings_layout.py:188
msgid ""
"Base URL of a relay that can reach Telegram when this host cannot. Tried "
"first; the direct route is the fallback. Blank disables the relay."
msgstr ""
"Базовый URL релея, который достаёт до Телеграма, когда этот хост не "
"может. Пробуется первым, прямой путь — запасной. Пусто — релей выключен."

#: app/admin/settings_layout.py:191
msgid "Webhook POST retries"
msgstr "Повторов POST для вебхука"

#: app/admin/settings_layout.py:192
msgid "How many times delivery of an inbound webhook is retried."
msgstr "Сколько раз повторяется доставка входящего вебхука."

#: app/admin/settings_layout.py:193
msgid "Webhook POST timeout"
msgstr "Таймаут POST для вебхука"

#: app/admin/settings_layout.py:194
msgid "Seconds to wait for a webhook POST to answer."
msgstr "Сколько секунд ждать ответа на POST вебхука."

#: app/admin/settings_layout.py:195
msgid "Precondition probe budget"
msgstr "Бюджет времени на проверку условий"

#: app/admin/settings_layout.py:196
msgid ""
"Seconds allowed for the whole set of precondition probes together, before"
" offering a rung."
msgstr ""
"Сколько секунд отводится на все проверки условий вместе, прежде чем "
"предложить ступень."

#: app/admin/settings_layout.py:198
msgid "Verification ladder time budget"
msgstr "Бюджет времени на лестницу верификации"

#: app/admin/settings_layout.py:199
msgid ""
"Seconds allowed for the whole ladder once a rung has been selected — one "
"bound for every rung together, never one each."
msgstr ""
"Сколько секунд отводится на всю лестницу после выбора ступени — один "
"бюджет на все ступени вместе, а не на каждую по отдельности."

#: app/admin/settings_layout.py:201
msgid "How stale a proof may be"
msgstr "Насколько старым может быть подтверждение"

#: app/admin/settings_layout.py:202
msgid ""
"Refuse a route whose precondition was last proven longer ago than this, "
"in seconds."
msgstr ""
"Отклонять маршрут, чьё условие подтверждено раньше этого срока, в "
"секундах."

#: app/admin/settings_layout.py:204
msgid "Keep finished verifications for"
msgstr "Хранить завершённые верификации"

#: app/admin/settings_layout.py:205
msgid "Delete finished verifications after this many days."
msgstr "Удалять завершённые верификации через столько дней."

#: app/admin/settings_layout.py:206
msgid "Length of the daily ceiling window"
msgstr "Длина окна суточного лимита"

#: app/admin/settings_layout.py:207
msgid ""
"The window the daily paid-attempt ceilings count in, rolling backwards "
"from now, in hours."
msgstr ""
"Окно, в котором считаются суточные лимиты платных попыток, скользящее "
"назад от текущего момента, в часах."

#: app/admin/settings_layout.py:210
msgid "Callback signature time tolerance"
msgstr "Допустимое отклонение времени в подписи вебхука"

#: app/admin/settings_layout.py:211
msgid ""
"Refuse a signed Telegram Gateway callback whose timestamp is further than"
" this from now, in seconds — guards against replay."
msgstr ""
"Отклонять подписанный вебхук Telegram Gateway, если его метка времени "
"отстоит от текущего момента больше, чем на это значение в секундах — "
"защита от повтора."

#: app/admin/settings_layout.py:213
msgid "Operator lookup time budget"
msgstr "Бюджет времени на определение оператора"

#: app/admin/settings_layout.py:214
msgid ""
"How long the sender waits for an unknown recipient's operator before "
"routing by the rule's \"?\" entry, in seconds. The lookup itself keeps "
"running either way."
msgstr ""
"Сколько секунд отправитель ждёт определения оператора неизвестного "
"получателя, прежде чем маршрутизировать по записи «?» правила. Само "
"определение при этом продолжается в любом случае."

#: app/admin/settings_layout.py:217
msgid "Operator lookup endpoint"
msgstr "Адрес для определения оператора"

#: app/admin/settings_layout.py:218
msgid "The URL used to look up a number's operator and region."
msgstr "URL, по которому определяются оператор и регион номера."

#: app/admin/settings_layout.py:219
msgid "Operator lookup timeout"
msgstr "Таймаут определения оператора"

#: app/admin/settings_layout.py:220
msgid "Seconds allowed for one operator-lookup request."
msgstr "Сколько секунд отводится на один запрос определения оператора."

#: app/admin/settings_layout.py:221
msgid "Re-check an operator after"
msgstr "Перепроверять оператора через"

#: app/admin/settings_layout.py:222
msgid "Days after which a cached operator/region lookup is refreshed."
msgstr "Через сколько дней кэш оператора и региона обновляется."

#: app/admin/settings_layout.py:223
msgid "Ignore delivery reports older than"
msgstr "Игнорировать отчёты о доставке старше"

#: app/admin/settings_layout.py:224
msgid ""
"Stop considering a delivery report once the message it names is older "
"than this many hours. The report is still recorded."
msgstr ""
"Не учитывать отчёт о доставке, если названное в нём сообщение старше "
"стольких часов. Сам отчёт всё равно записывается."

#: app/admin/settings_layout.py:227
msgid "Refuse contradicting delivery reports"
msgstr "Отклонять противоречащие отчёты о доставке"

#: app/admin/settings_layout.py:228
msgid ""
"Refuse a delivery report whose recipient address contradicts the only "
"candidate message, instead of recording the contradiction and attributing"
" it anyway."
msgstr ""
"Отклонять отчёт о доставке, если адрес получателя противоречит "
"единственному подходящему сообщению, вместо того чтобы зафиксировать "
"противоречие и всё равно засчитать доставку."

