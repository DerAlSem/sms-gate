# --- Bootstrap / infra config (read at startup; everything else is in the admin GUI: /admin/settings) ---

# Modem / serial
SERIAL_SEND_PORT=/dev/ttyUSB2
SERIAL_READ_PORT=/dev/ttyUSB3
SERIAL_BAUDRATE=115200

# Storage
DB_PATH=data/sms.db

# Server
HOST=0.0.0.0
PORT=80

# Admin UI (HTTP Basic). CHANGE THESE before exposing the service.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Telegram user account — the `tg_user` rung. CREDENTIALS: this file's mode, not the
# admin GUI. All three empty (the default) means the rung is not wired at all and every
# message goes to the modem exactly as it does today; the ladder then records
# "route is configured but not wired" for anyone who put `tg_user` in the route order.
#
# TG_API_ID / TG_API_HASH are issued at my.telegram.org and belong to a person, not to a
# host. TG_SESSION_DIR must be an ABSOLUTE path — systemd expands no `~` — readable by
# the service user, holding one `<account>.session` file per sender account. A session is
# signed in once, by hand, with `deploy/tg-sign-in.py`; the login code arrives in that
# account's own Telegram app, so no unattended run can do it.
# TG_API_ID=
# TG_API_HASH=
# TG_SESSION_DIR=

# NOTE: voxlink, Telegram alerting, inbound dispatch, blacklist threshold,
# delivery timeout, and phone_region (validation country, seeded to RU) are now
# configured at runtime via /admin/settings (stored in the DB). Client app tokens
# are managed via /admin/apps. On first start, any of these still present in this
# file are migrated into the DB once, then ignored here.
